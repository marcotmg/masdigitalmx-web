# Copiar a .env.local para desarrollo. En producción/preview se configura
# en el dashboard del hosting (Netlify → Site settings → Environment variables).

# URL de Formspree para el formulario de contacto. Sin esta var el endpoint
# falla explícito (500) — ver app/api/contacto/route.ts. Migrado de
# FormSubmit a Formspree en W-FORM-CONTACTO-CAIDO-01 (2026-08-12); esta
# entrada estaba desactualizada (seguía documentando FORMSUBMIT_URL).
FORMSPREE_URL=https://formspree.io/f/xxxxxxxx

# Webhook opcional (ej. workflow de n8n) que recibe un aviso cuando falla el
# envío a Formspree. Sin esta var, la falla solo queda en logs del hosting.
CONTACTO_ALERT_WEBHOOK_URL=

# W-FORM-01 (2026-08-12): Cloudflare Turnstile. Sin estas 2 vars, la
# verificación se OMITE (no bloquea el formulario) — ver comentario junto a
# TURNSTILE_SECRET_KEY en route.ts. Site key es público por diseño de
# Turnstile, no es un secreto pese al prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# W-FORM-01 (2026-08-12): shared secret anti-bot. Sin estas 2 vars, la
# verificación se OMITE (no bloquea el formulario) — ver comentario junto a
# CONTACTO_SHARED_SECRET en route.ts. La variante NEXT_PUBLIC_ es extraíble
# del bundle por diseño — filtra bots genéricos, no un atacante dirigido.
CONTACTO_SHARED_SECRET=
NEXT_PUBLIC_CONTACTO_SHARED_SECRET=

# W-FORM-01 (2026-08-13): rate-limit vía Upstash Redis (sustituye el
# in-memory anterior). Sin estas 2 vars, el rate-limit se OMITE (no bloquea
# el formulario) — ver comentario junto a UPSTASH_REDIS_REST_URL en
# route.ts. Crear la base de datos en https://console.upstash.com (free
# tier, región us-east-1 recomendada por Netlify) y copiar el REST URL/Token
# de su panel — no confundir con las credenciales de conexión Redis nativa.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
