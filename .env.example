# Copiar a .env.local para desarrollo. En producción/preview se configura
# en el dashboard del hosting (Netlify → Site settings → Environment variables).

# URL de FormSubmit para el formulario de contacto. Si no se define, usa el
# valor por defecto (contacto@masdigitalmx.com) — ver app/api/contacto/route.ts
FORMSUBMIT_URL=https://formsubmit.co/ajax/contacto@masdigitalmx.com
