# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# netlify — estado local del sitio vinculado, no es contenido del proyecto
.netlify

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code skills (instalados localmente para mejorar la calidad de diseño —
# impeccable, ui-ux-pro-max, design-taste-frontend, huashu-design. Reinstalables
# desde su fuente vía skills-lock.json — no son contenido del proyecto, no se comitean.
# gitignore evita que `git clean -fd` los borre y que un `git add -A` futuro los suba
# por accidente. Documentados como parte de la estructura esperada en CLAUDE.md.)
.claude/skills/
.agents/skills/
skills-lock.json
.install-log.txt
